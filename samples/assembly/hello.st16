; hello.st16 — sample 1 (difficulty: easy)
; Objective: memory-mapped I/O — STORE to the console out port (0xF000).
; Expected output: Hi
;
; STORE pops the address (top) then the value, so the value is pushed
; first and the port address second.

main:
        PUSH16 0x48         ; 'H'
        PUSH16 0xF000
        STORE               ; print 'H'
        PUSH16 0x69         ; 'i'
        PUSH16 0xF000
        STORE               ; print 'i'
        HALT
