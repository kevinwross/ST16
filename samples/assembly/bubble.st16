; bubble.st16 — sample 5 (difficulty: hard)
; Objective: computed memory addresses (base+offset), nested loops, and
; a swap built from LOAD/STORE stack juggling.
; Bubble-sorts five single-digit values in RAM and prints them as
; ASCII digits.
; Expected output: 13589

main:
        PUSH 4              ; i
outer:
        PUSH 0              ; j
inner:
        DUP                 ; i j j
        PUSH16 arr
        ADD                 ; i j A          (A = arr + j)
        LOAD                ; i j v1
        OVER                ; i j v1 j
        PUSH 1
        ADD                 ; i j v1 (j+1)
        PUSH16 arr
        ADD                 ; i j v1 B
        LOAD                ; i j v1 v2
        GT                  ; i j (v1 > v2)
        JNZ do_swap         ; i j
        JMP next            ; i j
do_swap:
        DUP                 ; i j j
        PUSH16 arr
        ADD                 ; i j A
        LOAD                ; i j v1
        OVER                ; i j v1 j
        PUSH 1
        ADD                 ; i j v1 (j+1)
        PUSH16 arr
        ADD                 ; i j v1 B
        STORE               ; i j v1         (mem[B] = v1)
        DUP                 ; i j v1 v1
        PUSH16 arr
        ADD                 ; i j v1 A
        LOAD                ; i j v1 v2      (v2 = original mem[A])
        SWAP                ; i j v2 v1
        DROP                ; i j v2
        OVER                ; i j v2 j
        PUSH16 arr
        ADD                 ; i j v2 A
        STORE               ; i j            (mem[A] = v2)
next:
        OVER                ; i j j
        PUSH 1
        ADD                 ; i j (j+1)
        SWAP                ; i (j+1) j
        DROP                ; i (j+1)
        OVER                ; i (j+1) i
        LT                  ; i (j+1) ((j+1) < i)
        JNZ inner
        DROP                ; i
        DUP
        PUSH 1
        SUB                 ; i (i-1)
        SWAP                ; (i-1) i
        DROP                ; (i-1)
        DUP
        JNZ outer
        ; print arr[0..4] as ASCII digits
        PUSH 0              ; k
print:
        DUP                 ; k k
        PUSH 5
        LT                  ; k (k < 5)
        JZ end              ; k
        DUP                 ; k k
        PUSH16 arr
        ADD                 ; k (arr + k)
        LOAD                ; k d
        PUSH 0x30
        ADD                 ; k ('0' + d)
        PUSH16 0xF000
        STORE               ; k
        DUP                 ; k k
        PUSH 1
        ADD                 ; k (k+1)
        SWAP
        DROP                ; k+1
        JMP print
end:
        DROP
        DROP                ; (stray 0 left by the outer loop)
        HALT
arr:
        .dw 5, 3, 8, 1, 9
