; 02-sq — square 7 with a CALL/RET pair (spec §9.1) and print the result.
;
; The argument travels on the operand stack: CALL pushes the return
; address, the callee returns its result on top, and RET pops the call
; stack. 7 * 7 = 49, which is ASCII '1'.
;
; Expected console output: 1

main:
    PUSH 7                  ; argument x
    CALL sq                 ; two words: 0x2000, address of sq
    PUSH16 0xF000           ; print the result (49)
    STORE
    HALT

sq:                         ; [x] → [x*x]
    DUP
    MUL
    RET
